# Copy to .env for local dev. Never commit real values.
PORT=3000
# Secret required (Authorization: Bearer <API_KEY>) on every write route. Shared with MCP B.
API_KEY=change-me
# SQLite file path (on Railway, point this to a mounted volume, e.g. /data/moon.db)
DATABASE_PATH=./moon.db
# Insert the labelled test workflow when the database is empty ("false" to disable)
SEED_TEST_DATA=true
# In-app Claude panel (optional). Without ANTHROPIC_API_KEY the chat box stays disabled.
ANTHROPIC_API_KEY=
# Required in production when the chat is enabled: code typed once in the panel (keeps strangers from spending credits)
ASSISTANT_ACCESS_CODE=
