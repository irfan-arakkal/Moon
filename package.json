{
  "name": "moon",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "mcp"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start:mcp": "npm run start -w mcp"
  }
}
